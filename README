    <script>
        // Простой таймер обратного отсчета
        function updateCountdown() {
            // Устанавливаем дату завершения работ (через 2 дня)
            const targetDate = new Date();
            targetDate.setDate(targetDate.getDate() + 2);
            targetDate.setHours(12, 45, 0, 0);
            
            const now = new Date();
            const diff = targetDate - now;
            
            if (diff <= 0) {
                document.getElementById('days').textContent = '00';
                document.getElementById('hours').textContent = '00';
                document.getElementById('minutes').textContent = '00';
                return;
            }
            
            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            
            document.getElementById('days').textContent = days.toString().padStart(2, '0');
            document.getElementById('hours').textContent = hours.toString().padStart(2, '0');
            document.getElementById('minutes').textContent = minutes.toString().padStart(2, '0');
        }
        
        // Обновляем таймер каждую минуту
        updateCountdown();
        setInterval(updateCountdown, 60000);
        
        // Анимация для иконок
        const icons = document.querySelectorAll('.icon');
        icons.forEach((icon, index) => {
            icon.style.animationDelay = `${index * 0.5}s`;
        });
        
        // Имитация кликов по ссылкам
        document.querySelectorAll('.site-list a').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                alert('В обычных условиях эта ссылка вела бы на соответствующий ресурс. В данный момент основной сайт на технических работах.');
            });
        });
    </script>
